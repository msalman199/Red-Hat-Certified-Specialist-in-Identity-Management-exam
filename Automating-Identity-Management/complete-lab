Task 2: Use Ansible to Configure HBAC and Sudo Rules
Subtask 2.1: Create HBAC Rules Playbook
Host-Based Access Control (HBAC) rules determine which users can access which hosts and services.

Create HBAC configuration playbook:
cat > playbooks/configure-hbac.yml << 'EOF'
---
- name: Configure HBAC Rules
  hosts: localhost
  gather_facts: false
  vars:
    ipaadmin_password: "RedHat123!"
    
    # Define host groups
    host_groups:
      - name: production_servers
        description: "Production environment servers"
        hosts:
          - idm-client1.example.com
      - name: development_servers
        description: "Development environment servers"
        hosts: []

    # Define HBAC rules
    hbac_rules:
      - name: sysadmin_access
        description: "System administrators full access"
        users: []
        groups:
          - sysadmins
        hosts: []
        hostgroups:
          - production_servers
          - development_servers
        services:
          - sshd
          - sudo
      - name: developer_dev_access
        description: "Developers access to development servers"
        users: []
        groups:
          - developers
        hosts: []
        hostgroups:
          - development_servers
        services:
          - sshd

  tasks:
    - name: Create host groups
      freeipa.ansible_freeipa.ipahostgroup:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        state: present
      loop: "{{ host_groups }}"
      delegate_to: idm-server

    - name: Add hosts to host groups
      freeipa.ansible_freeipa.ipahostgroup:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.0.name }}"
        host: "{{ item.1 }}"
        action: member
        state: present
      with_subelements:
        - "{{ host_groups }}"
        - hosts
      when: item.1 is defined and item.1 != ""
      delegate_to: idm-server

    - name: Create HBAC rules
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        state: present
      loop: "{{ hbac_rules }}"
      delegate_to: idm-server

    - name: Configure HBAC rule groups
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        group: "{{ item.groups }}"
        action: member
        state: present
      loop: "{{ hbac_rules }}"
      when: item.groups is defined and item.groups | length > 0
      delegate_to: idm-server

    - name: Configure HBAC rule host groups
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        hostgroup: "{{ item.hostgroups }}"
        action: member
        state: present
      loop: "{{ hbac_rules }}"
      when: item.hostgroups is defined and item.hostgroups | length > 0
      delegate_to: idm-server

    - name: Configure HBAC rule services
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        hbacsvc: "{{ item.services }}"
        action: member
        state: present
      loop: "{{ hbac_rules }}"
      when: item.services is defined and item.services | length > 0
      delegate_to: idm-server

    - name: Disable default allow_all rule
      freeipa.ansible_freeipa.ipahbacrule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: allow_all
        state: disabled
      delegate_to: idm-server
EOF
Subtask 2.2: Create Sudo Rules Playbook
Create sudo rules configuration playbook:
cat > playbooks/configure-sudo.yml << 'EOF'
---
- name: Configure Sudo Rules
  hosts: localhost
  gather_facts: false
  vars:
    ipaadmin_password: "RedHat123!"
    
    # Define sudo command groups
    sudo_command_groups:
      - name: system_commands
        description: "System administration commands"
        commands:
          - /usr/bin/systemctl
          - /usr/bin/mount
          - /usr/bin/umount
          - /usr/sbin/service
      - name: user_management
        description: "User management commands"
        commands:
          - /usr/sbin/useradd
          - /usr/sbin/userdel
          - /usr/sbin/usermod
          - /usr/bin/passwd

    # Define sudo rules
    sudo_rules:
      - name: sysadmin_full_sudo
        description: "Full sudo access for system administrators"
        users: []
        groups:
          - sysadmins
        hosts: []
        hostgroups:
          - production_servers
        commands:
          - ALL
        options:
          - "!authenticate"
      - name: developer_limited_sudo
        description: "Limited sudo access for developers"
        users: []
        groups:
          - developers
        hosts: []
        hostgroups:
          - development_servers
        command_groups:
          - system_commands

  tasks:
    - name: Create sudo command groups
      freeipa.ansible_freeipa.ipasudocmdgroup:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        state: present
      loop: "{{ sudo_command_groups }}"
      delegate_to: idm-server

    - name: Add commands to sudo command groups
      freeipa.ansible_freeipa.ipasudocmd:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.1 }}"
        state: present
      with_subelements:
        - "{{ sudo_command_groups }}"
        - commands
      delegate_to: idm-server

    - name: Associate commands with command groups
      freeipa.ansible_freeipa.ipasudocmdgroup:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.0.name }}"
        sudocmd: "{{ item.1 }}"
        action: member
        state: present
      with_subelements:
        - "{{ sudo_command_groups }}"
        - commands
      delegate_to: idm-server

    - name: Create sudo rules
      freeipa.ansible_freeipa.ipasudorule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        state: present
      loop: "{{ sudo_rules }}"
      delegate_to: idm-server

    - name: Configure sudo rule groups
      freeipa.ansible_freeipa.ipasudorule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        group: "{{ item.groups }}"
        action: member
        state: present
      loop: "{{ sudo_rules }}"
      when: item.groups is defined and item.groups | length > 0
      delegate_to: idm-server

    - name: Configure sudo rule host groups
      freeipa.ansible_freeipa.ipasudorule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        hostgroup: "{{ item.hostgroups }}"
        action: member
        state: present
      loop: "{{ sudo_rules }}"
      when: item.hostgroups is defined and item.hostgroups | length > 0
      delegate_to: idm-server

    - name: Configure sudo rule commands (ALL)
      freeipa.ansible_freeipa.ipasudorule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        allow_sudocmd_category: all
        state: present
      loop: "{{ sudo_rules }}"
      when: item.commands is defined and 'ALL' in item.commands
      delegate_to: idm-server

    - name: Configure sudo rule command groups
      freeipa.ansible_freeipa.ipasudorule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        sudocmdgroup: "{{ item.command_groups }}"
        action: member
        state: present
      loop: "{{ sudo_rules }}"
      when: item.command_groups is defined and item.command_groups | length > 0
      delegate_to: idm-server

    - name: Configure sudo rule options
      freeipa.ansible_freeipa.ipasudorule:
        ipaadmin_password: "{{ ipaadmin_password }}"
        name: "{{ item.name }}"
        sudooption: "{{ item.options }}"
        action: member
        state: present
      loop: "{{ sudo_rules }}"
      when: item.options is defined and item.options | length > 0
      delegate_to: idm-server
EOF
