Task 3: Automate IdM Server Setup and Client Enrollment
Subtask 3.1: Create IdM Server Installation Playbook
Create the IdM server installation playbook:
cat > playbooks/install-idm-server.yml << 'EOF'
---
- name: Install and Configure IdM Server
  hosts: idm_servers
  become: true
  vars:
    idm_domain: example.com
    idm_realm: EXAMPLE.COM
    idm_admin_password: RedHat123!
    idm_ds_password: RedHat123!
    idm_hostname: "{{ inventory_hostname }}.{{ idm_domain }}"

  tasks:
    - name: Set hostname
      hostname:
        name: "{{ idm_hostname }}"

    - name: Update /etc/hosts
      lineinfile:
        path: /etc/hosts
        line: "{{ ansible_default_ipv4.address }} {{ idm_hostname }} {{ inventory_hostname }}"
        state: present

    - name: Install required packages
      dnf:
        name:
          - ipa-server
          - ipa-server-dns
          - bind-dyndb-ldap
        state: present

    - name: Check if IdM is already installed
      stat:
        path: /etc/ipa/default.conf
      register: idm_installed

    - name: Install IdM server
      command: >
        ipa-server-install
        --domain={{ idm_domain }}
        --realm={{ idm_realm }}
        --ds-password={{ idm_ds_password }}
        --admin-password={{ idm_admin_password }}
        --hostname={{ idm_hostname }}
        --setup-dns
        --forwarder=8.8.8.8
        --forwarder=8.8.4.4
        --unattended
      when: not idm_installed.stat.exists
      register: idm_install_result

    - name: Start and enable IdM services
      systemd:
        name: ipa
        state: started
        enabled: true

    - name: Open firewall ports
      firewalld:
        service: "{{ item }}"
        permanent: true
        state: enabled
        immediate: true
      loop:
        - freeipa-ldap
        - freeipa-ldaps
        - dns
        - ntp
        - http
        - https
        - kerberos
        - kpasswd

    - name: Get Kerberos ticket for admin
      shell: echo "{{ idm_admin_password }}" | kinit admin
      no_log: true

    - name: Display installation status
      debug:
        msg: "IdM server installation completed successfully"
      when: idm_install_result is succeeded or idm_installed.stat.exists
EOF
Subtask 3.2: Create Client Enrollment Playbook
Create the client enrollment playbook:
cat > playbooks/enroll-idm-clients.yml << 'EOF'
---
- name: Enroll IdM Clients
  hosts: idm_clients
  become: true
  vars:
    idm_domain: example.com
    idm_server: idm-server.example.com
    idm_admin_password: RedHat123!
    idm_hostname: "{{ inventory_hostname }}.{{ idm_domain }}"

  tasks:
    - name: Set hostname
      hostname:
        name: "{{ idm_hostname }}"

    - name: Update /etc/hosts with IdM server
      lineinfile:
        path: /etc/hosts
        line: "192.168.1.10 {{ idm_server }} idm-server"
        state: present

    - name: Update /etc/hosts with client hostname
      lineinfile:
        path: /etc/hosts
        line: "{{ ansible_default_ipv4.address }} {{ idm_hostname }} {{ inventory_hostname }}"
        state: present

    - name: Install IdM client packages
      dnf:
        name:
          - ipa-client
          - oddjob-mkhomedir
        state: present

    - name: Check if client is already enrolled
      stat:
        path: /etc/ipa/default.conf
      register: client_enrolled

    - name: Enroll client to IdM domain
      command: >
        ipa-client-install
        --domain={{ idm_domain }}
        --server={{ idm_server }}
        --hostname={{ idm_hostname }}
        --principal=admin
        --password={{ idm_admin_password }}
        --unattended
        --enable-dns-updates
        --mkhomedir
      when: not client_enrolled.stat.exists
      register: client_enrollment_result

    - name: Start and enable SSSD
      systemd:
        name: sssd
        state: started
        enabled: true

    - name: Enable automatic home directory creation
      systemd:
        name: oddjobd
        state: started
        enabled: true

    - name: Configure PAM for home directory creation
      lineinfile:
        path: /etc/pam.d/system-auth
        line: "session optional pam_oddjob_mkhomedir.so skel=/etc/skel umask=0022"
        insertafter: "session.*pam_unix.so"
        state: present

    - name: Test IdM authentication
      command: id admin@{{ idm_domain }}
      register: auth_test
      failed_when: auth_test.rc != 0

    - name: Display enrollment status
      debug:
        msg: "Client {{ inventory_hostname }} successfully enrolled to IdM domain {{ idm_domain }}"
      when: client_enrollment_result is succeeded or client_enrolled.stat.exists
EOF
Subtask 3.3: Create Complete IdM Deployment Playbook
Create a master playbook that orchestrates the entire deployment:
cat > playbooks/deploy-complete-idm.yml << 'EOF'
---
- name: Complete IdM Deployment
  hosts: localhost
  gather_facts: false
  vars:
    deployment_phases:
      - name: "IdM Server Installation"
        playbook: "install-idm-server.yml"
      - name: "Client Enrollment"
        playbook: "enroll-idm-clients.yml"
      - name: "User and Group Management"
        playbook: "manage-users-groups.yml"
      - name: "HBAC Configuration"
        playbook: "configure-hbac.yml"
      - name: "Sudo Configuration"
        playbook: "configure-sudo.yml"

  tasks:
    - name: Display deployment plan
      debug:
        msg: "Starting complete IdM deployment with {{ deployment_phases | length }} phases"

    - name: Execute deployment phases
      debug:
        msg: "Phase: {{ item.name }} - Playbook: {{ item.playbook }}"
      loop: "{{ deployment_phases }}"

- import_playbook: install-idm-server.yml
- import_playbook: enroll-idm-clients.yml

- name: Wait for IdM services to be ready
  hosts: localhost
  tasks:
    - name: Wait for IdM server to be ready
      wait_for:
        host: idm-server
        port: 443
        timeout: 300

- import_playbook: manage-users-groups.yml
- import_playbook: configure-hbac.yml
- import_playbook: configure-sudo.yml

- name: Deployment Summary
  hosts: localhost
  tasks:
    - name: Display completion message
      debug:
        msg: |
          IdM deployment completed successfully!
          
          Services configured:
          - IdM Server: idm-server.example.com
          - Enrolled Clients: {{ groups['idm_clients'] | join(', ') }}
          - Users and Groups: Created via automation
          - HBAC Rules: Configured for access control
          - Sudo Rules: Configured for privilege escalation
          
          Next steps:
          1. Test user authentication
          2. Verify HBAC rules
          3. Test sudo access
          4. Configure additional clients as needed
EOF
